# ==============================================================================
# BHUMISETU — Platform Environment Configuration Template (.env.example)
# Copy this file to .env for local overrides or configure in Hosting Dashboard
# ==============================================================================

# Server Port (Render/Railway/Heroku inject PORT automatically)
PORT=8000

# Backend API Configuration
PROJECT_NAME=BHUMISETU
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Authentication (JWT Secret key - replace with secure random string in production)
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL (SQLite default fallback if Postgres URL is omitted)
# Format for PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./bhumisetu.db

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend API Target URL (Set when frontend is built separately; leave blank for bundled single-container deployment)
VITE_API_URL=http://localhost:8000
